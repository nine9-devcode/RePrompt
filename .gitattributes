# Normalize line endings: LF in the repo, native in the working tree.
* text=auto

# Force LF for files that break with CRLF
*.sh text eol=lf

# Force CRLF for Windows-only scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never diff or normalize
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.db binary
