@RePrompt.Api_HostAddress = http://localhost:5144

### List prompts (paged; limit is clamped to 1..100)
GET {{RePrompt.Api_HostAddress}}/api/prompts?limit=20&offset=0
Accept: application/json

### Search and filter
GET {{RePrompt.Api_HostAddress}}/api/prompts?search=cat&category=Portrait&model=sd_xl
Accept: application/json

### Filter by tags (comma separated, AND semantics)
GET {{RePrompt.Api_HostAddress}}/api/prompts?tags=cyberpunk,night
Accept: application/json

### All tags with usage counts
GET {{RePrompt.Api_HostAddress}}/api/tags
Accept: application/json

### Hide NSFW entries server-side (strict mode)
GET {{RePrompt.Api_HostAddress}}/api/prompts?includeNsfw=false
Accept: application/json

### Single prompt
GET {{RePrompt.Api_HostAddress}}/api/prompts/1
Accept: application/json

### Autocomplete values for model / sampler / category
GET {{RePrompt.Api_HostAddress}}/api/suggestions
Accept: application/json

### Create a prompt
# imageUrl must be a url returned by POST /api/upload.
POST {{RePrompt.Api_HostAddress}}/api/prompts
Content-Type: application/json

{
  "title": "Neon city street",
  "positivePrompt": "neon city street, rain, cinematic lighting",
  "negativePrompt": "blurry, lowres",
  "modelName": "sd_xl_base_1.0",
  "sampler": "Euler a",
  "steps": 30,
  "cfgScale": 7.5,
  "seed": "3942611316",
  "category": "Landscape",
  "isNsfw": false,
  "tags": ["cyberpunk", "night"],
  "images": []
}

### Update a prompt
PUT {{RePrompt.Api_HostAddress}}/api/prompts/1
Content-Type: application/json

{
  "title": "Neon city street (v2)",
  "positivePrompt": "neon city street, rain, cinematic lighting, 8k",
  "negativePrompt": "blurry, lowres",
  "modelName": "sd_xl_base_1.0",
  "sampler": "DPM++ 2M",
  "steps": 35,
  "cfgScale": 8,
  "seed": "3942611316",
  "category": "Landscape",
  "isNsfw": false,
  "tags": ["cyberpunk", "night"],
  "images": []
}

### Delete a prompt (also removes its files from disk)
DELETE {{RePrompt.Api_HostAddress}}/api/prompts/1

### Download a full backup (prompts.json + images/) as a zip
GET {{RePrompt.Api_HostAddress}}/api/export

### Discard an upload that was never attached to a prompt
DELETE {{RePrompt.Api_HostAddress}}/api/uploads/REPLACE_WITH_STORED_FILE_NAME.png

### Delete a single image
DELETE {{RePrompt.Api_HostAddress}}/api/images/1

###
